@page "/ledger"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Nav
@rendermode InteractiveServer

@if (!Session.IsLoggedIn) { Nav.NavigateTo("/login"); return; }

<div class="page-body">
    <h1>Internal Ledger</h1>
    <div class="alert alert-info">The Cinturon360 internal ledger is the source of truth for all financial movements. Provider references are recorded for traceability but the ledger is owned by Cinturon360.</div>

    @if (_loading) { <p>Loading...</p> }
    else if (_entries != null)
    {
        <table>
            <thead><tr><th>Date/Time</th><th>Type</th><th>Description</th><th>Debit</th><th>Credit</th><th>Currency</th><th>Ext. Ref</th></tr></thead>
            <tbody>
                @foreach (var e in _entries)
                {
                    <tr>
                        <td>@e.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="badge badge-gray">@e.EntryType</span></td>
                        <td>@e.Description</td>
                        <td>@(e.DebitAmount > 0 ? e.DebitAmount.ToString("N2") : "—")</td>
                        <td>@(e.CreditAmount > 0 ? e.CreditAmount.ToString("N2") : "—")</td>
                        <td>@e.CurrencyCode</td>
                        <td class="text-muted">@(e.ExternalReference ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<LedgerEntryDto>? _entries;
    bool _loading = true;
    protected override async Task OnInitializedAsync() { _entries = await Api.GetLedgerAsync(); _loading = false; }
}
