@page "/login"
@layout EmptyLayout
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Nav
@rendermode InteractiveServer

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#1a2235;">
    <div style="background:#fff;padding:32px;border-radius:12px;width:360px;box-shadow:0 4px 24px rgba(0,0,0,.3);">
        <h1 style="margin-bottom:4px;">
            <span style="color:#38bdf8;">Cinturon</span><span style="color:#f97316;">360</span><span style="color:#94a3b8;font-size:0.6em;font-weight:400;margin-left:8px;">MVP [dev]</span>
        </h1>
        <p style="color:#667;font-size:0.85rem;margin-bottom:24px;">Mid-Office Demo Platform</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-error">@_error</div>
        }

        <div class="form-group">
            <label>Email</label>
            <input class="form-control" type="email" @bind="_email" placeholder="demo@avanoa.local" />
        </div>
        <div class="form-group">
            <label>Password</label>
            <input class="form-control" type="password" @bind="_password" @onkeyup="HandleKeyUp" placeholder="DemoPassword123!" />
        </div>
        <button class="btn btn-primary" style="width:100%;margin-top:8px;" @onclick="DoLogin" disabled="@_loading">
            @(_loading ? "Signing in..." : "Sign In")
        </button>

        <div style="margin-top:20px;padding-top:16px;border-top:1px solid #e5e7eb;font-size:0.75rem;color:#9ca3af;">
            <div><strong>Demo credentials:</strong></div>
            <div>demo@avanoa.local / DemoPassword123!</div>
        </div>
    </div>
</div>

@code {
    string _email = "", _password = "", _error = "";
    bool _loading;

    async Task DoLogin()
    {
        _loading = true; _error = "";
        try
        {
            var r = await Api.LoginAsync(new LoginRequest { Email = _email, Password = _password });
            if (r?.Success == true)
            {
                Session.UserEmail = r.UserEmail;
                Session.UserRole = r.UserRole;
                Session.OrganisationName = r.OrganisationName;
                Nav.NavigateTo("/");
            }
            else _error = r?.ErrorMessage ?? "Login failed";
        }
        catch { _error = "Could not reach API. Is the server running?"; }
        finally { _loading = false; }
    }

    async Task HandleKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await DoLogin(); }
}
